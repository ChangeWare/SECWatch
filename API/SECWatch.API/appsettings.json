{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${POSTGRES_HOST};Database=${POSTGRES_DB};User Id=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};TrustServerCertificate=True"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}",
    "DatabaseName": "${MONGO_DB}",
    "FinancialMetricsCollection": "financial_metrics"
  },
  "CorsOrigins": [
    "${CLIENT_HOST}"
  ],
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "EmailVerificationTokenExpiryHours": 24,
    "PasswordResetTokenExpiryHours": 1,
    "UserTokenExpiryHours": 24,
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_ISSUER}"
  },
  "Email": {
    "SmtpServer": "${SMTP_SERVER}",
    "Port": 587,
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "${SMTP_FROM_NAME}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mailgun": {
    "Domain": "${MAILGUN_DOMAIN}",
    "ApiKey": "${MAILGUN_API_KEY}"
  }
}
