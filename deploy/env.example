# SECWatch Deployment Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored for security

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_DB=secwatch
POSTGRES_USER=secwatch_user
POSTGRES_PASSWORD=your-secure-password-here

# Redis Configuration
REDIS_CONNECTION_STRING=localhost:6379,password=your-redis-password

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=secwatch_user
MONGO_PASSWORD=your-mongo-password
MONGO_DB=secwatch

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=secwatch_user
RABBITMQ_PASSWORD=your-rabbitmq-password

# JWT Configuration
JWT_SECRET=your-very-long-random-secret-key-here-minimum-32-characters
JWT_ISSUER=SECWatch

# Email Configuration (SMTP)
SMTP_SERVER=smtp.example.com
SMTP_USERNAME=notifications@changeware.net
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=notifications@changeware.net
SMTP_FROM_NAME=SECWatch

# Mailgun Configuration (optional, if using Mailgun instead of SMTP)
MAILGUN_DOMAIN=your-domain.com
MAILGUN_API_KEY=your-mailgun-api-key

# Client Configuration
CLIENT_HOST=http://localhost:5173

# Nginx Configuration
NGINX_SERVER_NAME=localhost

# Deployment Configuration
DEPLOY_USER=your-username
DEPLOY_HOST=your-server-ip-or-hostname
DEPLOY_PATH=/opt/secwatch
SSH_KEY=~/.ssh/id_rsa
API_PORT=5181
CLIENT_PORT=80

